{
  "projectdoc": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./hooks/check_update.py",
        "timeout": 12
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./hooks/documentation.py --antigravity",
        "timeout": 20
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./hooks/documentation.py --antigravity",
        "timeout": 20
      }
    ]
  }
}
